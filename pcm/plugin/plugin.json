{
    "$schema": "https://go.kicad.org/api/schemas/v1",
    "identifier": "com.github.sijah.fab-release",
    "name": "Fab Release",
    "description": "prefab-gate check, then a full fab release of the open board.",
    "runtime": {
        "type": "python"
    },
    "actions": [
        {
            "identifier": "release",
            "name": "Fab Release",
            "description": "Choose outputs, run prefab-gate on a copy of the saved board, then build the release folder and zip.",
            "show-button": true,
            "scopes": [
                "pcb"
            ],
            "entrypoint": "ipc_entry.py",
            "icons-light": [
                "icon24.png",
                "icon48.png"
            ],
            "icons-dark": [
                "icon24_dark.png",
                "icon48_dark.png"
            ]
        }
    ]
}
