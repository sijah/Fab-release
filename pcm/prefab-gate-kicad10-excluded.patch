+    def test_kicad10_excluded_flag_is_an_exclusion(self):
+        """KiCad 10 keeps the rule's severity and marks the exclusion with "excluded": true."""
+        excluded = dict(violation("error"), excluded=True)
+        v = classify(drc(violations=[excluded, dict(violation("warning"), excluded=True)]))
+        self.assertEqual((len(v.blocking), len(v.cosmetic), v.excluded), (0, 0, 2))
+        self.assertTrue(v.passed)
+        v = classify(drc(violations=[excluded]), strict=True)
+        self.assertEqual(len(v.blocking), 0)
